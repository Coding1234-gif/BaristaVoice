SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
REVENUECAT_API_KEY_ANDROID=goog_xxx
REVENUECAT_API_KEY_IOS=appl_xxx
# Optional: RevenueCat Test Store key (Project settings -> API keys -> Test
# Store). Works on any platform and takes priority over the two keys above
# when set — lets you exercise the purchase flow before real store products
# exist. Leave blank once you're testing against real store products.
REVENUECAT_API_KEY_TEST=

# Optional: which cafe this kiosk install serves. Leave blank to use the
# hardcoded seed menu. Set to a `cafes.id` UUID (see the Cafe Admin
# dashboard's Settings page) to serve that cafe's published menu instead.
CAFE_ID=
