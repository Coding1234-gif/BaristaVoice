# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets - never commit real keys.
# The app actually loads a file literally named `env` (see
# dotenv.load(fileName: 'env') in main.dart), not `.env` — both patterns are
# kept so neither name can slip through. `env` was already tracked in git
# before this line existed; adding the pattern only stops FUTURE commits to
# it, it doesn't remove what's already in history.
.env
env

# Android release signing - never commit the keystore or its passwords.
# Losing this file/password means you can NEVER update the app on Play
# Store again under the same listing, so back it up somewhere safe
# (password manager / secure cloud storage) outside of git.
android/key.properties
android/app/upload-keystore.jks
*.jks
*.keystore
